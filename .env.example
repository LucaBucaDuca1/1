# Server Configuration
SERVER_PORT=3001
NODE_ENV=production

# Security
JWT_SECRET=change-this-to-a-random-secure-string-in-production

# Client Configuration
CLIENT_PORT=3000
VITE_API_URL=http://localhost:3001

# Nginx Configuration (for production with reverse proxy)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Database
DB_PATH=./data/database.sqlite
MEDIA_PATH=./media

# Docker Compose Profile
# Set to 'production' to enable nginx reverse proxy
COMPOSE_PROFILES=
